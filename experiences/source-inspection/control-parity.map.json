  "additions": [
    {
      "component": "trace-mode-readout",
      "reason": "The plan requires trace mode to be explicit throughout the interface. The reference implied it only in fixed prose; this states it as bound state so observed replay and live execution cannot later be confused with it."
    },
    {
      "component": "workbench-eyebrow",
      "reason": "The reference's eyebrow text, declared as its own component rather than as template decoration."
    },
    {
      "component": "capability-title",
      "reason": "The reference's title, declared as a component."
    },
    {
      "component": "capability-select",
      "reason": "The estate catalogue is 218 capabilities; the reference workbench could only show the one its page was built for. Selecting a capability is the point of a workbench over a diagram."
    },
    {
      "component": "scenario-select",
      "reason": "A capability's scenarios are its own declared data. Narrowing to one is how a person drills into the part of a circuit they care about."
    },
    {
      "component": "telemetry-title",
      "reason": "Names the run whose delivery the panel reports, so telemetry is never read as belonging to a different run."
    },
    {
      "component": "run-telemetry",
      "reason": "Reported delivery phases map to no circuit node. They are shown beside the circuit rather than drawn on it, because drawing them would claim evidence the instrumentation never produced."
    }
