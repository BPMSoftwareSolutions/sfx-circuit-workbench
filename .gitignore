*.pyc
.venv/
node_modules/

# Local credentials are supplied by the environment, never source control.
.env
.env.*
*.env
!.env.example
!.env.template

# Generated output. Rebuild rather than commit:
#   python tools/build_workbench.py     -> build/
#   python tools/m2_gate.py             -> evidence/
build/
evidence/

# Deliberately NOT ignored, because these are inputs rather than output:
#   fixtures/baseline/**     the frozen reference, retained byte for byte
#   fixtures/scenes/**       ingested scenes; small, and worth reviewing in a diff
#   providers/resolved/**    resolved provider profiles; the theme is reviewable output
#   experiences/derived/**   derived surface and experience; the optionality proof's subject
